{
  "name": "beacon",
  "version": "1.0.1",
  "packageManager": "pnpm@11.5.0",
  "description": "A modern self-hosted music player with Multi-room casting support.",
  "keywords": [
    "subsonic",
    "navidrome",
    "jellyfin",
    "react",
    "electron"
  ],
  "homepage": "https://github.com/mihaitom/beacon",
  "bugs": {
    "url": "https://github.com/mihaitom/beacon/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "beacon.desktop",
  "author": {
    "name": "Thomas Mihailovits",
    "email": "beacon@users.noreply.github.com",
    "url": "https://github.com/mihaitom/"
  },
  "scripts": {
    "dev": "concurrently -k -s first -n connect,electron \"pnpm:dev:connect\" \"pnpm:dev:electron\"",
    "dev:electron": "electron-vite dev",
    "dev:connect": "cd connect && uv run python main.py",
    "dev:web": "concurrently -k -s first -n connect,web \"pnpm:dev:connect\" \"pnpm:dev:web:vite\"",
    "dev:web:vite": "vite --config web.vite.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config web.vite.config.ts",
    "start": "electron-vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:layout": "vitest run --config vitest.browser.config.ts",
    "package:connect": "cd connect && uv run python packaging/build-binary.py",
    "package": "npm run package:connect && electron-vite build && electron-builder",
    "package:dir": "npm run package:connect && electron-vite build && electron-builder --dir",
    "publish": "npm run package:connect && electron-vite build && electron-builder --publish always",
    "publish:linux": "npm run package:connect && electron-vite build && electron-builder --publish always --linux --x64",
    "publish:linux-arm64": "npm run package:connect && electron-vite build && electron-builder --publish always --linux --arm64",
    "publish:mac": "npm run package:connect && electron-vite build && electron-builder --publish always --mac",
    "publish:win": "npm run package:connect && electron-vite build && electron-builder --publish always --win --x64",
    "publish:win-arm64": "npm run package:connect && electron-vite build && electron-builder --publish always --win --arm64",
    "type-check": "vue-tsc --build",
    "bump-version": "pnpm version --no-git-tag-version --no-git-checks",
    "postversion": "node ./scripts/sync-connect-version.mjs && node ./scripts/finalize-changelog.mjs",
    "prepare": "husky",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mdi/font": "^7.4.47",
    "blueimp-md5": "^2.19.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "markdown-it": "^15.0.0",
    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^3.13.1"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/blueimp-md5": "^2.18.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.73.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.5",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "lint-staged": {
    "src/**/*.{ts,vue,mts,tsx}": [
      "oxlint --fix",
      "eslint --fix --cache",
      "prettier --write --experimental-cli"
    ],
    "src/**/*.{css,html,json,webmanifest}": "prettier --write --experimental-cli"
  }
}
