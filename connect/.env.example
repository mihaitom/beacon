# Server
PORT=7071

# Optional — an alternate, more directly reachable address for Navidrome
# than whatever URL you log in with (see routes/proxy.py), e.g. if Navidrome
# runs on this same machine behind a reverse proxy that handles the public
# domain: pointing this at the local address skips that hop for every
# proxied request. Leave unset if there's no such shortcut — Beacon then
# just uses whatever URL you log in with. Jellyfin has its own equivalent,
# JELLYFIN_INTERNAL_URL, below — Plex has none (see routes/devices.py).
# NAVIDROME_INTERNAL_URL=http://localhost:4533

# Same idea as NAVIDROME_INTERNAL_URL above, but for Jellyfin sessions
# specifically — kept as a separate variable rather than reusing
# NAVIDROME_INTERNAL_URL for both, since a Jellyfin session pinged against a
# Navidrome-shaped internal URL always failed (Navidrome has no /Users/Me
# endpoint).
# JELLYFIN_INTERNAL_URL=http://localhost:8096

# Locks this deployment to one specific server — see docker-compose.yaml's
# SERVER_URL/SERVER_LOCK comment for what each actually does (SERVER_URL is
# not what the proxy above uses to reach Navidrome).
# SERVER_URL=https://navidrome.example.com
# SERVER_LOCK=true

# What kind of server SERVER_URL/SERVER_LOCK above point at — "subsonic"
# (covers Navidrome, the default), "jellyfin", or "plex". Only relevant
# together with SERVER_LOCK=true; tells the login screen to skip the
# server-type picker too.
# SERVER_TYPE=subsonic

# Debug logging — logs everything, expect a lot of output
# DEBUG=true

# Token for the Connect API (an insecure default is used otherwise). Only
# needed explicitly for a remote/Docker deployment — see docker-compose.yaml.
# CONNECT_TOKEN=change-me

# Where persistent backend files (paired AirPlay 2 credentials, and — for
# Jellyfin/Plex sessions only — user-managed internet radio stations) are stored
# — defaults to next to this file. Only relevant for Docker, where it
# should point at a mounted volume (see docker-compose.yaml).
# CONNECT_DATA_DIR=/data

# ── Live tests ───────────────────────────────────────────────────────────────
# Only for running the live suites against real servers (tests/
# test_bridges_live.py, tests/test_lyrics_live.py). They are excluded from
# the default run and skip themselves per server whenever the values below
# are absent, so nothing here is needed to run Beacon itself:
#
#   uv run pytest -m live
#
# Every variable below is a credential — this file is the example, the real
# values belong in .env, which is gitignored.

# Navidrome (or any other Subsonic server). Also covers the Subsonic half of
# cover art and streaming, which does not go through a bridge at all but
# through routes/proxy.py.
# SUBSONIC_TEST_URL=https://navidrome.example.com
# SUBSONIC_TEST_USER=beacon-tests
# SUBSONIC_TEST_PASSWORD=

# Jellyfin. The token has to be a *user* access token, the kind a login or
# Quick Connect hands out — an admin API key from the dashboard belongs to
# no user and fails in ways that look like bugs in the bridge (see
# test_bridges_live.py's module docstring). The user id is what
# GET /Users/Me returns for that token.
# JELLYFIN_TEST_URL=http://localhost:8096
# JELLYFIN_TEST_TOKEN=
# JELLYFIN_TEST_USER_ID=

# Plex. The token is the X-Plex-Token of an account that can reach the
# server.
# PLEX_TEST_URL=http://localhost:32400
# PLEX_TEST_TOKEN=

# A track that actually has lyrics of its own, per server — no library is
# guaranteed to have one, so those tests skip rather than assume. Ids are
# the ones each server itself uses.
# JELLYFIN_TEST_LYRICS_ITEM_ID=
# PLEX_TEST_LYRICS_ITEM_ID=
# SUBSONIC_TEST_LYRICS_SONG_ID=

# Opt-in for the two tests that trigger a real library scan on the server.
# Reading the scan status is always safe; starting one is not something to
# do to somebody's server by accident.
# LIVE_ALLOW_LIBRARY_SCAN=1
