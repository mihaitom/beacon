# Server
PORT=9181

# Optional — an alternate, more directly reachable address for Navidrome
# than whatever URL you log in with (see routes/proxy.py), e.g. if Navidrome
# runs on this same machine behind a reverse proxy that handles the public
# domain: pointing this at the local address skips that hop for every
# proxied request. Leave unset if there's no such shortcut — Beacon then
# just uses whatever URL you log in with, same as it already does for
# Jellyfin (which has no equivalent variable).
# SERVER_INTERNAL_URL=http://localhost:4533

# Locks this deployment to one specific server — see docker-compose.yaml's
# SERVER_URL/SERVER_LOCK comment for what each actually does (SERVER_URL is
# not what the proxy above uses to reach Navidrome).
# SERVER_URL=https://navidrome.example.com
# SERVER_LOCK=true

# What kind of server SERVER_URL/SERVER_LOCK above point at — "subsonic"
# (covers Navidrome, the default) or "jellyfin". Only relevant together with
# SERVER_LOCK=true; tells the login screen to skip the server-type picker too.
# SERVER_TYPE=subsonic

# Debug logging — verbose playback logs for ALL renderers (AirPlay + Sonos)
# DEBUG=true

# Token for the Connect API (an insecure default is used otherwise). Only
# needed explicitly for a remote/Docker deployment — see docker-compose.yaml.
# CONNECT_TOKEN=change-me

# Pre-configure devices locally, without going through Beacon
# TARGETS=sonos:Arbeitszimmer,airplay:HomePod Kueche

# Where persistent backend files (paired AirPlay 2 credentials, and — for
# Jellyfin sessions only — user-managed internet radio stations) are stored
# — defaults to next to this file. Only relevant for Docker, where it
# should point at a mounted volume (see docker-compose.yaml).
# CONNECT_DATA_DIR=/data
