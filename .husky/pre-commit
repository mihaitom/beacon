. .husky/lib.sh

# Only what answers in seconds runs here. The test suites live in pre-push:
# here they held every commit up for about six minutes, and a commit is
# made far more often than a push.

# Through run(): without it a failing lint-staged printed its eslint error
# and the hook went on to exit 0 anyway.
run "lint-staged" "pnpm exec lint-staged"

if git diff --cached --name-only | grep -qE '^(src/|tsconfig.*\.json)'; then
  # lint-staged above already formatted the staged files; this checks all of
  # src/, which is what catches drift in files nobody happens to be touching.
  # That gap is how src/main and src/preload sat unformatted for months —
  # they simply never showed up in a commit. --check only, same reasoning as
  # the connect/ block below: a hook that rewrites files mid-commit would
  # stage something the user never saw.
  run "src/ formatting" "pnpm format:check" "pnpm format"
  # Stays here rather than moving to pre-push: CI does not type-check, so
  # this is the only place it happens at all.
  run "type-check" "pnpm type-check"
fi

if git diff --cached --name-only | grep -q '^connect/'; then
  # Deliberately all of connect/, not just the staged files: ruff's findings
  # are cheap enough to re-derive wholesale, and a per-file run would miss
  # the case where editing one module breaks an import in another.
  run "connect/ lint" "cd connect && uv run --group dev ruff check ."
  # --check only: a hook that rewrites files under the user mid-commit would
  # stage something they never saw. On failure `ruff format connect/` fixes
  # it in one step, which the verdict says out loud.
  run "connect/ formatting" "cd connect && uv run --group dev ruff format --check ." \
    "(cd connect && uv run --group dev ruff format .)"
fi
