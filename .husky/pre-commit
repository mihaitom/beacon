pnpm exec lint-staged

if git diff --cached --name-only | grep -qE '^(src/|tsconfig.*\.json)'; then
  echo "→ src/ changed — type-checking…"
  pnpm type-check || exit 1
fi

if git diff --cached --name-only | grep -qE '^(src/renderer/|vitest\.config\.ts|vitest\.browser\.config\.ts)'; then
  echo "→ frontend changed — running the Vue test suite…"
  pnpm test:unit || exit 1
  pnpm test:layout || exit 1
fi

if git diff --cached --name-only | grep -q '^connect/'; then
  # Lint first — it answers in seconds, the suite takes ~40s. Note this
  # deliberately checks all of connect/, not just the staged files: ruff's
  # findings are cheap enough to re-derive wholesale, and a per-file run
  # would miss the case where editing one module breaks an import in
  # another.
  echo "→ connect/ changed — linting…"
  (cd connect && uv run --group dev ruff check .) || exit 1
  # --check only: a hook that rewrites files under the user mid-commit would
  # stage something they never saw. On failure `ruff format connect/` fixes
  # it in one step, which the message below says out loud.
  (cd connect && uv run --group dev ruff format --check .) || {
    echo "  ✗ formatting — run: (cd connect && uv run --group dev ruff format .)"
    exit 1
  }
  echo "→ connect/ changed — running the Python test suite…"
  (cd connect && uv run --group dev pytest) || exit 1
fi
